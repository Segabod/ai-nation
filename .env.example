# Postgres connection (Neon, Supabase, Vercel Postgres, or any Postgres 14+)
# Use the pooled URL here...
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# ...and the direct (non-pooled) URL here, used for migrations and seeding
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# First administrator, created by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password-123"

# Transactional email (Resend). Without RESEND_API_KEY, emails are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="AI Nation <hello@your-domain.com>"   # domain must be verified in Resend
EMAIL_REPLY_TO=""
APP_URL="https://your-domain.com"                 # used for links in emails

# Project evidence uploads (Vercel Blob). Set automatically when you connect a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=""
# BLOB_ACCESS="public"   # only if your Blob store is public; default is private
