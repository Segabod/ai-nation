# Postgres connection (Neon, Supabase, Vercel Postgres, or any Postgres 14+)
# Use the pooled URL here...
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# ...and the direct (non-pooled) URL here, used for migrations and seeding
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# First administrator, created by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password-123"
